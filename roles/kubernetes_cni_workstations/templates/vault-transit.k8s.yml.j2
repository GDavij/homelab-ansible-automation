---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vault-transit-data
  namespace: security
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ kubernetes_cni_workstations_vault_storage_class }}
  resources:
    requests:
      storage: 1Gi

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: vault-transit-config
  namespace: security
data:
  vault.hcl: |
    ui = false
    disable_mlock = true

    listener "tcp" {
      address     = "0.0.0.0:8200"
      tls_disable = true
    }

    storage "file" {
      path = "/vault/data"
    }

    api_addr = "http://vault-transit.security.svc.{{ cluster_domain }}:8200"

---
apiVersion: v1
kind: Service
metadata:
  name: vault-transit
  namespace: security
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  selector:
    app: vault-transit
  ports:
    - port: 8200
      targetPort: 8200
      name: http

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vault-transit
  namespace: security
  labels:
    app: vault-transit
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: vault-transit
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: vault-transit
    spec:
      serviceAccountName: vault
      securityContext:
        runAsUser: 100
        runAsGroup: 1000
        fsGroup: 1000
      containers:
        - name: vault
          image: {{ kubernetes_cni_workstations_vault_image }}
          command: ["vault", "server", "-config=/vault/config/vault.hcl"]
          ports:
            - containerPort: 8200
              name: http
          env:
            - name: VAULT_ADDR
              value: "http://127.0.0.1:8200"
            - name: VAULT_API_ADDR
              value: "http://vault-transit.security.svc.{{ cluster_domain }}:8200"
            - name: SKIP_CHOWN
              value: "true"
          volumeMounts:
            - name: data
              mountPath: /vault/data
            - name: config
              mountPath: /vault/config
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
          securityContext:
            capabilities:
              add: ["IPC_LOCK"]
          readinessProbe:
            httpGet:
              path: /v1/sys/health?standbyok=true&sealedcode=204&uninitcode=204
              port: 8200
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v1/sys/health?standbyok=true&sealedcode=204&uninitcode=204
              port: 8200
            initialDelaySeconds: 30
            periodSeconds: 15

        - name: vault-unseal
          image: curlimages/curl:latest
          env:
            - name: VAULT_UNSEAL_KEY
              valueFrom:
                secretKeyRef:
                  name: vault-transit-unseal-key
                  key: vault_transit_unseal_key
                  optional: true
          command:
            - /bin/sh
            - -c
            - |
              while true; do
                echo "$(date) checking vault seal status..."
                status=$(curl -s http://127.0.0.1:8200/v1/sys/seal-status)
                if echo "$status" | grep -q '"sealed":true' && echo "$status" | grep -q '"initialized":true' ; then
                  echo "$(date) vault is sealed. unsealing..."
                  curl -s --request POST --data "{\"key\": \"${VAULT_UNSEAL_KEY}\"}" http://127.0.0.1:8200/v1/sys/unseal
                fi
                sleep 5
              done
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 50m
              memory: 64Mi

      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: vault-transit-data
        - name: config
          configMap:
            name: vault-transit-config
